#!/bin/sh
# Conventional Commits, checked locally so the format is a habit rather than a
# review comment. The release notes are generated from these subjects, which is
# why the shape matters beyond tidiness.

msg_file="$1"
subject=$(head -1 "$msg_file")

# Merges, reverts and fixups are generated by git; leave them alone.
case "$subject" in
  "Merge "*|"Revert "*|"fixup!"*|"squash!"*) exit 0 ;;
esac

pattern='^(feat|fix|docs|refactor|test|build|ci|perf|chore|revert)(\([a-z0-9./-]+\))?!?: .{1,}$'

if ! printf '%s' "$subject" | grep -qE "$pattern"; then
  printf '\033[31m%s\033[0m\n' "The commit subject does not follow Conventional Commits."
  echo
  echo "  got:      $subject"
  echo "  expected: <type>(<scope>): <description>"
  echo
  echo "  types:    feat fix docs refactor test build ci perf chore revert"
  echo "  example:  fix(audit): compare anchors before reporting a chain valid"
  echo
  exit 1
fi

if [ ${#subject} -gt 100 ]; then
  printf '\033[31m%s\033[0m\n' "The commit subject is ${#subject} characters; keep it under 100."
  exit 1
fi

exit 0
