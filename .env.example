# SpecForge configuration.
#
# Copy to .env for local use. Every value here is either a local-only default
# or a placeholder — no real credential belongs in this file or in any file
# tracked by git. In deployed environments these come from the secret store;
# see docs/architecture/11-security-architecture.md.

# --- Runtime -----------------------------------------------------------------
SF_ENV=development                    # development | test | staging | production
SF_LOG_LEVEL=info
SF_LOG_FORMAT=json

# --- HTTP --------------------------------------------------------------------
SF_HTTP_ADDR=:8080
SF_HTTP_PUBLIC_BASE_URL=http://localhost:8080
SF_HTTP_ALLOWED_ORIGINS=http://localhost:3000
SF_METRICS_ADDR=:9090

# --- Database ----------------------------------------------------------------
# sslmode=verify-full outside local development. `require` encrypts but does not
# authenticate the server, which leaves the connection open to anything that can
# answer on the endpoint.
SF_DB_DSN=host=localhost port=5432 user=specforge password=specforge dbname=specforge sslmode=disable
SF_DB_MIGRATIONS_DIR=./migrations

# --- Object storage ----------------------------------------------------------
# Object lock is what makes approval evidence and audit anchors defensible.
# Leave it on.
SF_OBJSTORE_PROVIDER=s3
SF_OBJSTORE_ENDPOINT=http://localhost:9000
SF_OBJSTORE_CONTENT_BUCKET=sf-content
SF_OBJSTORE_EVIDENCE_BUCKET=sf-evidence
SF_OBJSTORE_OBJECT_LOCK=true
SF_OBJSTORE_ACCESS_KEY=specforge
SF_OBJSTORE_SECRET_KEY=specforge-dev-secret

# --- Cache and events --------------------------------------------------------
SF_CACHE_PROVIDER=redis
SF_CACHE_ADDR=localhost:6379
SF_EVENTS_PROVIDER=kafka
SF_EVENTS_BROKERS=localhost:9092

# --- Identity ----------------------------------------------------------------
# The development identity provider is a real OIDC provider with PKCE and
# asymmetric signing. It refuses to start in production, and the configuration
# validator refuses production with it enabled.
SF_AUTH_DEV_IDP=true
SF_AUTH_DEV_IDP_ADDR=:8081
SF_AUTH_ISSUER=http://localhost:8081
SF_AUTH_TENANT_CLAIM=https://specforge.io/tenant
SF_AUTH_ROLES_CLAIM=https://specforge.io/roles
SF_AUTH_CLIENT_ID=specforge-web
# SF_AUTH_CLIENT_SECRET=                 # from the secret store, never from here

# --- Governance --------------------------------------------------------------
SF_GOV_FOUR_EYES=true
SF_AUTH_STEP_UP_MAX_AGE=15m

# --- Console -----------------------------------------------------------------
# SPECFORGE_PUBLIC_URL is the origin a browser uses, which is not the address
# the container binds to. Post-authentication redirects are built from it.
SPECFORGE_API_URL=http://localhost:8080
SPECFORGE_PUBLIC_URL=http://localhost:3000
SPECFORGE_ISSUER_URL=http://localhost:8081
SPECFORGE_CLIENT_ID=specforge-web
SPECFORGE_REDIRECT_URL=http://localhost:3000/api/auth/callback
SPECFORGE_TENANT_CLAIM=https://specforge.io/tenant
SPECFORGE_ROLES_CLAIM=https://specforge.io/roles
# At least 32 characters. Generate with: openssl rand -base64 48
SPECFORGE_SESSION_SECRET=local-development-session-key-change-me-0123456789

# --- Observability -----------------------------------------------------------
SF_OTEL_ENDPOINT=http://localhost:4318
SF_OTEL_SAMPLE_RATIO=1.0
